rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function admin() { return signedIn() && request.auth.token.admin == true; }
  // All economy writes are server-only. Secret decks never leave /players.
  match /players/{id} { allow read, write: if false; }
  match /views/{id} {
   allow read: if signedIn() && (request.auth.uid == id || request.auth.uid in resource.data.parents || admin());
   allow write: if false;
  }
  match /memberships/{id} { allow read: if signedIn() && request.auth.uid == id; allow write: if false; }
  match /roomViews/{id} { allow read: if signedIn() && request.auth.uid in resource.data.members; allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
